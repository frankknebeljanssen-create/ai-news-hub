<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.frank.ai-news-hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/run.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- Taeglich 07:00 (Systemzeitzone Europe/Berlin), beim Anmelden und stuendlich.
       Das Skript beendet sich sofort, wenn fuer heute schon ein Lauf existiert. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/ai-news-hub.launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ai-news-hub.launchd.log</string>
</dict>
</plist>
